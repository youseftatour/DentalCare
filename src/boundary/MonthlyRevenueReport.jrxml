<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MonthlyRevenueReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c09de79e-1254-4587-b8a6-b24324e2ec11">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="revenueAdapter.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="reportMonth" class="java.lang.String"/>
	<parameter name="reportYear" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    a.TreatmentName,
    a.Cost,
    p.FirstName + ' ' + p.LastName AS DentistName
FROM 
    TblAppointments AS a
INNER JOIN 
    TblPersons AS p ON a.AssignedMedicalStaff = p.PersonID
WHERE 
    a.Status = 'Completed'
    AND Format(a.AppointmentDate, 'mm') = $P{reportMonth}
    AND Format(a.AppointmentDate, 'yyyy') = $P{reportYear}]]>
	</queryString>
	<field name="TreatmentName" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="TreatmentName"/>
		<property name="com.jaspersoft.studio.field.label" value="TreatmentName"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TblAppointments"/>
	</field>
	<field name="Cost" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="Cost"/>
		<property name="com.jaspersoft.studio.field.label" value="Cost"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TblAppointments"/>
	</field>
	<field name="DentistName" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="DENTISTNAME"/>
		<property name="com.jaspersoft.studio.field.label" value="DentistName"/>
	</field>
	<variable name="TotalRevenue" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost}]]></variableExpression>
	</variable>
	<variable name="TreatmentCostSum" class="java.lang.Double" resetType="Group" resetGroup="TreatmentGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost}]]></variableExpression>
	</variable>
	<variable name="DentistRevenue" class="java.lang.Double" resetType="Group" resetGroup="DentistGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost}]]></variableExpression>
	</variable>
	<group name="DentistGroup">
		<groupExpression><![CDATA[$F{DentistName}]]></groupExpression>
		<groupHeader>
			<band height="34">
				<textField>
					<reportElement x="100" y="6" width="300" height="20" uuid="b2c4b372-c606-4e91-b852-0280838e2998"/>
