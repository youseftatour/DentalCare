					<reportElement x="0" y="-16" width="300" height="20" forecolor="#2B5263" uuid="e19911e8-3fd9-4516-a51e-cce5ff6a6227"/>
					<textElement>
						<font isUnderline="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Total by " + $F{DentistName} + ": $" + new java.text.DecimalFormat("#,##0.00").format($V{DentistRevenue})]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
	<group name="TreatmentGroup">
		<groupExpression><![CDATA[$F{TreatmentName}]]></groupExpression>
