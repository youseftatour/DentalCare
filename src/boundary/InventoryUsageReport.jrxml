					<printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
				</reportElement>
			</rectangle>
			<textField>
				<reportElement x="0" y="0" width="300" height="20" uuid="51762c88-d2d3-4d1f-bfc4-0ff963db8397"/>
				<textFieldExpression><![CDATA[$F{ItemName}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="320" y="0" width="100" height="20" uuid="e9d7643f-93c5-4602-877a-85075505f4d5"/>
				<textFieldExpression><![CDATA[$F{TotalUsed}]]></textFieldExpression>
			</textField>
