				<textFieldExpression><![CDATA["From " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{StartDate}) + 
                                              " to " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{EndDate})]]></textFieldExpression>
			</textField>
		</band>
	</title>
