				<textFieldExpression><![CDATA["Total Items Used: " + $V{TotalUsed_SUM}]]></textFieldExpression>
			</textField>
			<pieChart>
				<chart evaluationTime="Report">
					<reportElement x="0" y="30" width="500" height="300" uuid="6b1ea325-b20f-41d3-9566-daa879ea0249"/>
					<chartTitle>
						<titleExpression><![CDATA["Item Usage Distribution"]]></titleExpression>
					</chartTitle>
					<chartSubtitle/>
					<chartLegend/>
